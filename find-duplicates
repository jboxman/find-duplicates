#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
VENV_PYTHON="$VENV_DIR/bin/python"

find_python() {
  local candidate

  for candidate in \
    /opt/homebrew/bin/python3 \
    /opt/homebrew/bin/python3.14 \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /opt/homebrew/bin/python3.11 \
    /opt/homebrew/bin/python3.10 \
    python3.14 \
    python3.13 \
    python3.12 \
    python3.11 \
    python3.10 \
    python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
      "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
        && {
          printf '%s\n' "$candidate"
          return 0
        }
    fi
  done

  return 1
}

if [[ -x "$VENV_PYTHON" ]]; then
  "$VENV_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' || {
    echo "Existing .venv uses Python < 3.10. Remove .venv, install Python 3.10+, then rerun ./find-duplicates." >&2
    exit 1
  }
else
  PYTHON_BIN="$(find_python)" || {
    echo "Python 3.10+ is required. Install it, then rerun ./find-duplicates." >&2
    exit 1
  }

  "$PYTHON_BIN" -m venv --upgrade-deps "$VENV_DIR"
  "$VENV_PYTHON" -m pip install -e "$ROOT_DIR" >/dev/null
fi

exec "$VENV_PYTHON" -m find_duplicates.cli "$@"
